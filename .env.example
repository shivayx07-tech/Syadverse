# ==============================================================================
# Syadverse — Environment Configuration Reference
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development
# or configure these variables in your deployment dashboard (Cloudflare / Vercel).
# NEVER commit real secrets or API keys to version control.
# ==============================================================================

# Transactional Email Dispatch (Resend: https://resend.com)
# Obtain your API key from https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=re_your_api_key_here

# Recipient Email Address
# The inbox where direct messages from your portfolio will be delivered.
# Defaults to shivayx07@gmail.com if omitted.
CONTACT_EMAIL=shivayx07@gmail.com

# Verified Sender Address
# In onboarding/testing mode on Resend, you can use onboarding@resend.dev
# In production with a custom verified domain (e.g. syadverse.com),
# set this to contact@syadverse.com or portfolio@yourdomain.com
CONTACT_FROM_EMAIL="Syadverse Contact <onboarding@resend.dev>"

# Optional Development Testing Mock
# Set to "true" only if you want local development submissions to log to
# the server console without requiring an active Resend API key.
# In production, leave unset or "false" so real email delivery is always enforced.
ALLOW_DEV_CONTACT_MOCK=false
